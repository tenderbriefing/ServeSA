# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=servesa-aad53.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=servesa-aad53
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=servesa-aad53.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Google Maps API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ServeSA
NEXT_PUBLIC_APP_DESCRIPTION=South African Service Platform

# Feature Flags
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_OFFLINE_REPORTING=true
NEXT_PUBLIC_ENABLE_VOICE_NOTES=true
NEXT_PUBLIC_ENABLE_FACE_BLUR=true
NEXT_PUBLIC_ENABLE_PLATE_BLUR=true

# API Endpoints
NEXT_PUBLIC_API_BASE_URL=https://africa-south1-servesa-aad53.cloudfunctions.net
NEXT_PUBLIC_OPEN311_ENDPOINT=https://africa-south1-servesa-aad53.cloudfunctions.net/api/open311
