{
  "name": "@servesa/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "next build && npm run copy-static",
    "copy-static": "xcopy .next\\static out\\_next\\static /E /I /Y && xcopy .next\\server out\\_next\\server /E /I /Y && copy .next\\server\\app\\page.html out\\index.html",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "deploy:dev": "npm run build:static && firebase deploy --only hosting:dev",
    "deploy:prod": "npm run build:static && firebase deploy --only hosting:prod",
    "test:e2e": "playwright test --config=../../playwright.config.ts",
    "test:e2e:pilot": "playwright test --config=../../playwright.config.ts --grep @pilot",
    "test:unit": "node --test tests/unit/**/*.test.mjs"
  },
  "dependencies": {
    "@servesa/case-contract": "*",
    "@googlemaps/js-api-loader": "^1.16.0",
    "@hookform/resolvers": "^3.3.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "axios": "^1.6.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^15.0.0",
    "exifr": "^7.1.3",
    "firebase": "^10.7.0",
    "framer-motion": "^10.16.0",
    "image-hash": "^5.3.2",
    "lucide-react": "^0.294.0",
    "next": "^15.0.0",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.2.1",
    "postcss": "^8.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.0",
    "react-ga4": "^2.1.0",
    "react-hook-form": "^7.48.0",
    "react-hot-toast": "^2.4.1",
    "recharts": "^2.8.0",
    "tailwind-merge": "^2.0.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.2.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "playwright": "^1.40.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.5.0"
  }
}
