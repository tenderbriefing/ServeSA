{
  "name": "@servesa/functions",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build -w @servesa/case-contract && mkdir -p vendor/case-contract && cp ../../packages/case-contract/package.json vendor/case-contract/ && rm -rf vendor/case-contract/dist && cp -R ../../packages/case-contract/dist vendor/case-contract/ && tsc -p tsconfig.deploy.json",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc -p tsconfig.deploy.json --noEmit"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/aiplatform": "^4.0.0",
    "@google-cloud/bigquery": "^7.3.0",
    "@google-cloud/recaptcha-enterprise": "^6.3.0",
    "@google-cloud/storage": "^7.7.0",
    "@google-cloud/vision": "^4.0.0",
    "@servesa/case-contract": "file:vendor/case-contract",
    "axios": "^1.6.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "express": "^4.18.2",
    "firebase": "^10.7.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1",
    "googleapis": "^128.0.0",
    "helmet": "^7.1.0",
    "image-hash": "^5.3.2",
    "lodash": "^4.17.21",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "node-fetch": "^2.7.0",
    "pdf-lib": "^1.17.1",
    "rate-limiter-flexible": "^4.0.1",
    "sharp": "^0.33.0",
    "uuid": "^9.0.1",
    "xml2js": "^0.6.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/lodash": "^4.14.202",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^9.0.7",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.2.0"
  }
}
