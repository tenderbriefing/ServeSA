{
  "firestore": {
    "rules": "infra/firestore.rules",
    "indexes": "infra/firestore.indexes.json"
  },
  "storage": {
    "rules": "infra/storage.rules"
  },
  "functions": [
    {
      "source": "apps/functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "apps/web/out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/report",
        "destination": "/report.html"
      },
      {
        "source": "/ops",
        "destination": "/ops.html"
      },
      {
        "source": "/ops/cases",
        "destination": "/ops/cases.html"
      },
      {
        "source": "/ops/case",
        "destination": "/ops/case.html"
      },
      {
        "source": "/ops/team",
        "destination": "/ops/team.html"
      },
      {
        "source": "/ops/settings",
        "destination": "/ops/settings.html"
      },
      {
        "source": "/ops/map",
        "destination": "/ops/map.html"
      },
      {
        "source": "/ops/supervisor",
        "destination": "/ops/supervisor.html"
      },
      {
        "source": "/field",
        "destination": "/field.html"
      },
      {
        "source": "/case",
        "destination": "/case.html"
      },
      {
        "source": "/dashboard",
        "destination": "/dashboard.html"
      },
      {
        "source": "/explore",
        "destination": "/explore.html"
      },
      {
        "source": "/community",
        "destination": "/community.html"
      },
      {
        "source": "/auth",
        "destination": "/auth.html"
      },
      {
        "source": "/help",
        "destination": "/help.html"
      },
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "/terms",
        "destination": "/terms.html"
      },
      {
        "source": "/case/**",
        "destination": "/case.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(self), microphone=(), geolocation=(self)"
          }
        ]
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
