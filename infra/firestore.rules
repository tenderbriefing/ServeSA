rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function hasRole(roles) {
      return request.auth.token.roles != null &&
             request.auth.token.roles.hasAny(roles);
    }

    function isOfficial() {
      return hasRole(['official', 'moderator', 'admin', 'field_worker']);
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    function canAccessMunicipality(muniCode) {
      return isAdmin() ||
             (isOfficial() && request.auth.token.municipalityCode == muniCode);
    }

    function canAccessWard(wardId) {
      return isAdmin() ||
             (isOfficial() && request.auth.token.wardId == wardId);
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isOfficial());
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'roles', 'municipalityCode', 'municipalityId', 'departmentId', 'role'
        ]);
      allow delete: if isAuthenticated() && isAdmin();
    }

    match /cases/{caseId} {
      allow read: if isAuthenticated() && (
        resource.data.reporterUid == request.auth.uid ||
        (isOfficial() && canAccessMunicipality(resource.data.muniCode))
      );

      // All case writes are Admin SDK (Cloud Functions) only.
      allow create, update, delete: if false;

      match /events/{eventId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/cases/$(caseId)).data.reporterUid == request.auth.uid ||
          (isOfficial() && canAccessMunicipality(
            get(/databases/$(database)/documents/cases/$(caseId)).data.muniCode
          ))
        );
        allow create, update, delete: if false;
      }

      // Municipal staff only — never citizen-readable (field workers may read own muni notes if official-scoped)
      match /internal_notes/{noteId} {
        allow read: if isAuthenticated() && hasRole(['official', 'moderator', 'admin']) && canAccessMunicipality(
          get(/databases/$(database)/documents/cases/$(caseId)).data.muniCode
        );
        allow create, update, delete: if false;
      }

      // Citizen-visible updates
      match /public_updates/{updateId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/cases/$(caseId)).data.reporterUid == request.auth.uid ||
          (isOfficial() && canAccessMunicipality(
            get(/databases/$(database)/documents/cases/$(caseId)).data.muniCode
          ))
        );
        allow create, update, delete: if false;
      }
    }

    match /municipalities/{muniCode} {
      allow read: if true;
      allow create, update, delete: if false;

      match /departments/{departmentId} {
        allow read: if isAuthenticated() && canAccessMunicipality(muniCode);
        allow create, update, delete: if false;
      }

      match /category_department_map/{category} {
        allow read: if isAuthenticated() && canAccessMunicipality(muniCode);
        allow create, update, delete: if false;
      }
    }

    match /wards/{wardId} {
      allow read: if true;
      allow update: if isAuthenticated() && canAccessWard(wardId);
      allow create, delete: if isAuthenticated() && isAdmin();
    }

    match /cap_alerts/{alertId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    match /analytics/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /service_categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated() && isAdmin();
    }

    match /audit_logs/{logId} {
      allow create: if false;
      allow read: if isAuthenticated() && isOfficial();
      allow update, delete: if false;
    }

    match /case_idempotency/{id} {
      allow read, write: if false;
    }
    match /case_media/{id} {
      allow read, write: if false;
    }
    match /case_events/{id} {
      allow read, write: if false;
    }
    match /notification_ledger/{id} {
      allow read, write: if false;
    }
    match /georesolve_cache/{id} {
      allow read, write: if false;
    }
    match /email_logs/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
