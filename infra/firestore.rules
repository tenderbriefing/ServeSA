rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function hasRole(roles) {
      return request.auth.token.roles != null &&
             request.auth.token.roles.hasAny(roles);
    }

    function isOfficial() {
      return hasRole(['official', 'moderator', 'admin']);
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    function canAccessMunicipality(muniCode) {
      return isAdmin() ||
             (isOfficial() && request.auth.token.municipalityCode == muniCode);
    }

    function canAccessWard(wardId) {
      return isAdmin() ||
             (isOfficial() && request.auth.token.wardId == wardId);
    }

    function isCaseOwner() {
      return isAuthenticated() && resource.data.reporterUid == request.auth.uid;
    }

    function publicCaseFieldsOnly() {
      // Client reads of another user's case are denied; share views go via Cloud Functions.
      return false;
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isOfficial());
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if isAuthenticated() && isAdmin();
    }

    match /cases/{caseId} {
      // Citizens read own cases; officials read within municipality
      allow read: if isAuthenticated() && (
        resource.data.reporterUid == request.auth.uid ||
        (isOfficial() && canAccessMunicipality(resource.data.muniCode))
      );

      // Case creation is performed by Admin SDK (Cloud Functions).
      // Citizens must not write reporter contact fields directly from the client.
      allow create: if false;

      // Officials may update operational fields only. Authoritative routing fields
      // are server-controlled (Admin SDK / reconciliation). Admins may override.
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          isOfficial() &&
          canAccessMunicipality(resource.data.muniCode) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'wardId',
            'muniCode',
            'georesolution',
            'routingPending',
            'routingManualOverride',
            'location',
            'reporter',
            'reporterUid',
            'anonymousSessionId',
            'clientRequestId'
          ])
        )
      );

      allow delete: if isAuthenticated() && isAdmin();

      match /events/{eventId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/cases/$(caseId)).data.reporterUid == request.auth.uid ||
          (isOfficial() && canAccessMunicipality(
            get(/databases/$(database)/documents/cases/$(caseId)).data.muniCode
          ))
        );
        allow create, update, delete: if false;
      }
    }

    match /municipalities/{muniCode} {
      allow read: if true;
      allow update: if isAuthenticated() && canAccessMunicipality(muniCode);
      allow create, delete: if isAuthenticated() && isAdmin();
    }

    match /wards/{wardId} {
      allow read: if true;
      allow update: if isAuthenticated() && canAccessWard(wardId);
      allow create, delete: if isAuthenticated() && isAdmin();
    }

    match /cap_alerts/{alertId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    match /analytics/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /service_categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated() && isAdmin();
    }

    match /audit_logs/{logId} {
      allow create: if false;
      allow read: if isAuthenticated() && isOfficial();
      allow update, delete: if false;
    }

    // Idempotency, media metadata, ledger — Admin SDK only
    match /case_idempotency/{id} {
      allow read, write: if false;
    }
    match /case_media/{id} {
      allow read, write: if false;
    }
    match /case_events/{id} {
      allow read, write: if false;
    }
    match /notification_ledger/{id} {
      allow read, write: if false;
    }
    match /georesolve_cache/{id} {
      allow read, write: if false;
    }
    match /email_logs/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
