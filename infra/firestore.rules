rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function hasRole(roles) {
      return request.auth.token.roles != null &&
             request.auth.token.roles.hasAny(roles);
    }

    function isOfficial() {
      return hasRole(['official', 'moderator', 'admin', 'field_worker', 'comms_editor', 'comms_publisher']);
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    function canAccessMunicipality(muniCode) {
      return isAdmin() ||
             (isOfficial() && request.auth.token.municipalityCode == muniCode);
    }

    function canAccessWard(wardId) {
      return isAdmin() ||
             (isOfficial() && request.auth.token.wardId == wardId);
    }

    /** Privileged identity fields — never client-writable */
    function deniesPrivilegedUserFields() {
      return !request.resource.data.keys().hasAny([
        'roles', 'role', 'departmentId', 'municipalityId'
      ]);
    }

    match /users/{userId} {
      // Owner, admin, or official scoped to same municipality claim as profile
      allow read: if isAuthenticated() && (
        isOwner(userId) ||
        isAdmin() ||
        (
          hasRole(['official', 'moderator', 'admin', 'comms_editor', 'comms_publisher']) &&
          resource.data.keys().hasAny(['municipalityCode']) &&
          resource.data.municipalityCode == request.auth.token.municipalityCode
        )
      );
      // Citizens may create own profile without forging privileged roles
      allow create: if isAuthenticated() && isOwner(userId) && deniesPrivilegedUserFields();
      allow update: if isAuthenticated() && isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'roles', 'municipalityId', 'departmentId', 'role'
        ]);
      allow delete: if isAuthenticated() && isAdmin();
    }

    match /cases/{caseId} {
      allow read: if isAuthenticated() && (
        resource.data.reporterUid == request.auth.uid ||
        (isOfficial() && canAccessMunicipality(resource.data.muniCode))
      );

      // All case writes are Admin SDK (Cloud Functions) only.
      allow create, update, delete: if false;

      match /events/{eventId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/cases/$(caseId)).data.reporterUid == request.auth.uid ||
          (isOfficial() && canAccessMunicipality(
            get(/databases/$(database)/documents/cases/$(caseId)).data.muniCode
          ))
        );
        allow create, update, delete: if false;
      }

      // Municipal staff only — never citizen-readable
      match /internal_notes/{noteId} {
        allow read: if isAuthenticated() && hasRole(['official', 'moderator', 'admin']) && canAccessMunicipality(
          get(/databases/$(database)/documents/cases/$(caseId)).data.muniCode
        );
        allow create, update, delete: if false;
      }

      // Citizen-visible updates
      match /public_updates/{updateId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/cases/$(caseId)).data.reporterUid == request.auth.uid ||
          (isOfficial() && canAccessMunicipality(
            get(/databases/$(database)/documents/cases/$(caseId)).data.muniCode
          ))
        );
        allow create, update, delete: if false;
      }
    }

    match /municipalities/{muniCode} {
      allow read: if true;
      allow create, update, delete: if false;

      match /departments/{departmentId} {
        allow read: if isAuthenticated() && canAccessMunicipality(muniCode);
        allow create, update, delete: if false;
      }

      match /category_department_map/{category} {
        allow read: if isAuthenticated() && canAccessMunicipality(muniCode);
        allow create, update, delete: if false;
      }
    }

    match /wards/{wardId} {
      allow read: if true;
      allow update: if isAuthenticated() && canAccessWard(wardId);
      allow create, delete: if isAuthenticated() && isAdmin();
    }

    match /cap_alerts/{alertId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    match /analytics/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /service_categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated() && isAdmin();
    }

    match /audit_logs/{logId} {
      allow create: if false;
      allow read: if isAuthenticated() && isOfficial();
      allow update, delete: if false;
    }

    // Municipal Updates — Admin SDK writes only
    match /municipal_updates/{updateId} {
      allow read: if resource.data.status in ['published', 'updated', 'resolved'] ||
        (isAuthenticated() && canAccessMunicipality(resource.data.municipalityCode));
      allow create, update, delete: if false;
    }

    match /municipal_update_events/{eventId} {
      allow read: if isAuthenticated() && canAccessMunicipality(resource.data.municipalityCode);
      allow create, update, delete: if false;
    }

    // Community Ideas — Admin SDK writes; citizens may read non-private statuses
    match /community_ideas/{ideaId} {
      allow read: if resource.data.status in [
          'submitted', 'under_review', 'community_support', 'feasibility_review',
          'planned', 'in_progress', 'implemented', 'declined'
        ] ||
        (isAuthenticated() && resource.data.authorUid == request.auth.uid) ||
        (isAuthenticated() && canAccessMunicipality(resource.data.municipalityCode));
      allow create, update, delete: if false;

      match /supports/{uid} {
        allow read: if isAuthenticated() && (
          request.auth.uid == uid ||
          canAccessMunicipality(
            get(/databases/$(database)/documents/community_ideas/$(ideaId)).data.municipalityCode
          )
        );
        allow create, update, delete: if false;
      }

      // Internal notes never leak to citizens
      match /internal_notes/{noteId} {
        allow read: if isAuthenticated() && hasRole(['official', 'moderator', 'admin']) &&
          canAccessMunicipality(
            get(/databases/$(database)/documents/community_ideas/$(ideaId)).data.municipalityCode
          );
        allow create, update, delete: if false;
      }
    }

    match /community_idea_events/{eventId} {
      allow read: if isAuthenticated() && canAccessMunicipality(resource.data.municipalityCode);
      allow create, update, delete: if false;
    }

    match /case_idempotency/{id} {
      allow read, write: if false;
    }
    match /idea_idempotency/{id} {
      allow read, write: if false;
    }
    match /case_media/{id} {
      allow read, write: if false;
    }
    match /case_events/{id} {
      allow read, write: if false;
    }
    match /notification_ledger/{id} {
      allow read, write: if false;
    }
    match /georesolve_cache/{id} {
      allow read, write: if false;
    }
    match /email_logs/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
