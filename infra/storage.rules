rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function hasRole(roles) {
      return request.auth.token.roles != null &&
             request.auth.token.roles.hasAny(roles);
    }

    function isOfficial() {
      return hasRole(['official', 'moderator', 'admin']);
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    function canAccessMunicipality(muniCode) {
      return isAdmin() ||
             (isOfficial() && request.auth.token.municipalityCode == muniCode);
    }

    function isValidImageType() {
      return request.resource.contentType.matches('image/.*');
    }

    function isValidMediaType() {
      return isValidImageType() ||
             request.resource.contentType.matches('video/(mp4|quicktime)') ||
             request.resource.contentType.matches('audio/.*');
    }

    function isUnderMaxSize() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    function isUnderImageMaxSize() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    function caseExists(caseId) {
      return firestore.exists(/databases/(default)/documents/cases/$(caseId));
    }

    function caseReporterUid(caseId) {
      return firestore.get(/databases/(default)/documents/cases/$(caseId)).data.reporterUid;
    }

    function caseMuniCode(caseId) {
      return firestore.get(/databases/(default)/documents/cases/$(caseId)).data.muniCode;
    }

    match /cases/{caseId}/media/{fileName} {
      allow create: if isAuthenticated() &&
        isValidMediaType() &&
        isUnderMaxSize() &&
        caseExists(caseId) &&
        caseReporterUid(caseId) == request.auth.uid;

      allow read: if isAuthenticated() &&
        caseExists(caseId) &&
        (
          caseReporterUid(caseId) == request.auth.uid ||
          (isOfficial() && canAccessMunicipality(caseMuniCode(caseId)))
        );

      allow update: if isAuthenticated() && isOfficial() &&
        caseExists(caseId) &&
        canAccessMunicipality(caseMuniCode(caseId));

      allow delete: if isAuthenticated() && isAdmin();
    }

    // Derived thumbnails — authenticated read only (reporter or same-muni official).
    // Original case media above stays auth-scoped; do not reintroduce public thumbnail read.
    match /cases/{caseId}/thumbnails/{fileName} {
      allow read: if isAuthenticated() &&
        caseExists(caseId) &&
        (
          caseReporterUid(caseId) == request.auth.uid ||
          (isOfficial() && canAccessMunicipality(caseMuniCode(caseId)))
        );
      allow create, update: if false;
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Municipal update / idea media — Admin SDK or authenticated owner upload via temp then callable
    match /municipal_updates/{updateId}/media/{fileName} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    match /community_ideas/{ideaId}/media/{fileName} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    /**
     * QA / phash fixture prefix — NOT public (no anonymous/public read).
     * Production phash verification should use signed URLs or Cloud Functions mediation;
     * do not grant public read on this prefix or on case media.
     */
    match /qa/phash-fixtures/{fileName} {
      allow read: if isAuthenticated() && isAdmin();
      allow create, update: if isAuthenticated() &&
        isAdmin() &&
        isValidImageType() &&
        isUnderImageMaxSize();
      allow delete: if isAuthenticated() && isAdmin();
    }

    match /users/{userId}/avatar/{fileName} {
      allow create: if isAuthenticated() &&
        isOwner(userId) &&
        isValidImageType() &&
        isUnderImageMaxSize();
      allow read: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() &&
        isOwner(userId) &&
        isValidImageType() &&
        isUnderImageMaxSize();
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    match /public/{fileName} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() && isAdmin();
    }

    match /temp/{userId}/{fileName} {
      allow create: if isAuthenticated() &&
        isOwner(userId) &&
        isValidMediaType() &&
        isUnderMaxSize();
      allow read: if isAuthenticated() && isOwner(userId);
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    match /cases/{caseId}/resolution/{fileName} {
      allow create: if isAuthenticated() && isOfficial() &&
        caseExists(caseId) &&
        canAccessMunicipality(caseMuniCode(caseId)) &&
        isValidMediaType() &&
        isUnderMaxSize();

      allow read: if isAuthenticated() &&
        caseExists(caseId) &&
        (
          caseReporterUid(caseId) == request.auth.uid ||
          (isOfficial() && canAccessMunicipality(caseMuniCode(caseId)))
        );

      allow update: if isAuthenticated() && isOfficial() &&
        caseExists(caseId) &&
        canAccessMunicipality(caseMuniCode(caseId));

      allow delete: if isAuthenticated() && isAdmin();
    }

    /**
     * Municipal planning document upload — Admin SDK writes only.
     * Unpublished/processing paths: ops read via signed URLs.
     */
    match /municipal_planning/{muniCode}/documents/{documentId}/{fileName} {
      allow read, write: if false;
    }

    match /municipal_planning/{muniCode}/processing/{documentId}/{fileName} {
      allow read, write: if false;
    }

    /** Published official sources — public read when explicitly published by server */
    match /municipal_planning/{muniCode}/published/{documentId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
